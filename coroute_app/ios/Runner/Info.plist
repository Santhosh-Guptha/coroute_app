<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose a photo of your group to add to your trip review.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo of your group to add to your trip review.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>CoRoute uses the microphone for the live convoy intercom while you hold Talk or arm VOX.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>CoRoute uses speech recognition to operate hands-free riding features via voice commands.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>CoRoute shares your position with your convoy so riders can stay together.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>CoRoute keeps sharing your position with your convoy while the screen is off during a ride.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>CoRoute keeps sharing your position with your convoy while the screen is off during a ride and for crash detection.</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>PreciseRiding</key>
		<string>CoRoute needs your exact position so your group can find you and an SOS or crash alert points to where you are.</string>
	</dict>
	<key>NSMotionUsageDescription</key>
	<string>CoRoute uses motion sensors during a ride to detect a crash and alert your group.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>CoRoute uses Bluetooth to route ride alerts and the intercom to your helmet headset and to connect handlebar remotes.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>CoRoute uses Bluetooth to communicate with helmet headsets and handlebar controllers.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>CFBundleDisplayName</key>
	<string>CoRoute</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>coroute_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>sms</string>
		<string>tel</string>
		<string>om</string>
		<string>googlechromes</string>
		<string>comgooglemaps</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>space.devmonks.coroute</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>coroute</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
