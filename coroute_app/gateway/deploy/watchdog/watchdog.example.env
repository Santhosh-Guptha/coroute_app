# /etc/coroute/watchdog.env on vm3 (v3.56). Real IPs only here on the VM, never in git.
# name|kind|url[|tls name]   kind = http (2xx; /api/health must say HEALTHY) or ws (upgrade must answer 101)
WATCH_TARGETS="public|http|https://coroute.devmonks.space/api/health public-ws|ws|wss://coroute.devmonks.space/ws legacy|http|https://coroute.duckdns.org/api/health vm1|http|https://<vm1-public-ip>/api/health/live|coroute.duckdns.org vm2|http|https://<vm2-public-ip>/api/health/live|coroute.duckdns.org staging|http|https://staging.coroute.devmonks.space/api/health dr-local|http|http://127.0.0.1:3000/api/health"
WATCH_INTERVAL_S=30
WATCH_FAILS=3
WATCH_SUMMARY_HOUR_UTC=3
# Mail: SMTP_HOST / SMTP_PORT / SMTP_USER / MAIL_FROM like gateway.env; the SMTP password is read from /run/coroute/secrets.env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
MAIL_FROM=
ALERT_TO=
# Automatic DR promotion: OFF unless the owner decides otherwise (RUNBOOK "DR and failover").
WATCH_AUTO_PROMOTE=0
WATCH_PROMOTE_WHEN=public,vm1,vm2
WATCH_PROMOTE_AFTER_MIN=15
WATCH_PROMOTE_CMD="bash /opt/coroute/gateway/deploy/dr/promote_vm3.sh --yes"
# Round 8 synthetic SOS probe (deploy/watchdog/sos_probe.js), STAGING ONLY: two dedicated staging test accounts in a
# group whose name starts with "SOS probe" and that has no other rider (the probe refuses anything else).
# The password goes in the secrets file read through WATCH_SMTP_ENV_FILE (/run/coroute/secrets.env), never here.
WATCH_SOS_PROBE=0
WATCH_SOS_PROBE_URL=wss://staging.coroute.devmonks.space/ws
WATCH_SOS_PROBE_API=https://staging.coroute.devmonks.space/api
WATCH_SOS_PROBE_GROUP=
WATCH_SOS_PROBE_EMAIL_A=
WATCH_SOS_PROBE_EMAIL_B=
WATCH_SOS_PROBE_EVERY_MIN=15
WATCH_SOS_PROBE_MAX_MS=1000
WATCH_SOS_PROBE_TIMEOUT_MS=10000
WATCH_SOS_PROBE_STATUS=/var/lib/coroute-watchdog/sos_probe.json
