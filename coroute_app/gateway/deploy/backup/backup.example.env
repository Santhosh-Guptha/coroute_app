# /etc/coroute/backup.env on vm3 (root, 0600). Settings for deploy/nightly_backup.py and deploy/backup/restore_drill.sh.
# Secrets (ORACLE_PASSWORD, BACKUP_ENCRYPTION_KEY, SMTP password) are NOT here: they come from /run/coroute/secrets.env.
BACKUP_DIR=/var/backups/coroute
# Tenancy-2 Object Storage, bucket "coroute-offsite" (private, Standard tier, lifecycle: delete after 100 days).
# A PAR with access type "Permit object writes" on the bucket (no read, no listing), expiring in 1 year; renew yearly.
OFFSITE_PAR_URL=
# Restore drill source on vm4 (only if the owner accepts the backup key on vm4): a SEPARATE read+list PAR.
# OFFSITE_READ_PAR_URL=
ALERT_TO=
DRILL_MAIL_TO=
