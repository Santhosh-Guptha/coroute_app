# ---------------------------------------------------------------------------
# CoRoute gateway configuration.  Copy to /etc/coroute/gateway.env (chmod 600).
# Nothing in this file is ever shipped inside the mobile app.
# ---------------------------------------------------------------------------
NODE_ENV=production
HOST=127.0.0.1          # Caddy terminates TLS and proxies to this port
PORT=3000

# Oracle Autonomous Database (Always Free) — ORDS SODA endpoint of a DEDICATED
# low-privilege schema (see RUNBOOK §2). Never use ADMIN here.
ORACLE_SODA_URL=https://<your-adb-host>.adb.ap-hyderabad-1.oraclecloudapps.com/ords/coroute/soda/latest
ORACLE_USER=COROUTE
ORACLE_PASSWORD=<strong-password>
ORACLE_TIMEOUT_MS=6000

# 64+ random chars:  openssl rand -base64 48
JWT_SECRET=<random-secret>
JWT_TTL_DAYS=30

# Google Sign-In: the OAuth *client IDs* whose ID tokens we accept (Android + Web ids, comma separated)
GOOGLE_CLIENT_IDS=<your-oauth-client-id>.apps.googleusercontent.com

# Seeds the FIRST admin only. After that, manage roles via PATCH /api/admin/users/:userId/role
BOOTSTRAP_ADMIN_EMAILS=<owner-email>

# Housekeeping (keeps accounts + trip records forever; strips GPS traces only)
RETENTION_ENDED_CONVOY_DAYS=90
RETENTION_VOICE_LOG_DAYS=7
RETENTION_STALE_CONVOY_HOURS=36
RETENTION_RUN_EVERY_MINUTES=360
DB_KEEPALIVE_EVERY_MINUTES=720

# Abuse and free-tier guards (defaults shown; change only if needed)
# USER_GATE_TTL_MS=30000          # how long an account check is cached (hold/block/delete apply at once anyway)
# JOIN_WINDOW_MIN=15               # wrong join codes: window in minutes
# JOIN_MAX_FAILURES=10             #   per rider in that window
# JOIN_MAX_FAILURES_PER_IP=30      #   per network in that window
# MAX_CONVOY_RIDERS=50             # riders in one convoy (also shown on the website)
# TRIP_MAX_TRAIL_POINTS=4000       # trail points kept per uploaded trip
# MAX_TRIPS_PER_USER=500
# TRIP_MAX_BYTES=1048576           # largest trip upload
# PV_MAX_REFERRERS=50              # website analytics: referrer hosts per page per day
# WS_ACTIONS_PER_SEC=10            # route/status/settings socket messages per second
# WS_ALARMS_PER_10S=3              # WAIT and SOS per 10 seconds

# Voice relay guards
VOICE_MAX_FRAME_BYTES=16384
VOICE_STREAM_IDLE_MS=1500
VOICE_MAX_STREAM_MS=60000

# Website
# Canonical public origin: every generated link (friend invites, join/live/guardian links, checkout, /api/meta,
# canonical/og/sitemap). Empty: pages use the request Host, other links https://coroute.duckdns.org.
# Domain move (docs/DOMAIN_MIGRATION_devmonks.md): PUBLIC_ORIGIN=https://coroute.devmonks.space
PUBLIC_ORIGIN=
# Older hosts still served in full (installed apps, old links); accepted for CORS and guardian Origin checks.
# Default: https://coroute.duckdns.org
# LEGACY_ORIGINS=https://coroute.duckdns.org
# true: website pages (GET/HEAD) on a legacy host get a 301 to PUBLIC_ORIGIN. Never /api, /ws, /.well-known,
# /e/ live links, /watch, /uploads. Turn on only after the app with the new default is widely installed.
REDIRECT_LEGACY_HOST=false
# Where /download sends people. Set PLAY_STORE_URL once the Play listing is live; until then the APK URL is used.
# The same https link also shows the "Rate CoRoute on Google Play" button on the website (restart to apply);
# empty = the site asks riders to share their story in the app instead. Example:
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=<your.package.id>
PLAY_STORE_URL=
# Empty = the APKs this gateway serves: <origin>/coroute.apk (64-bit) and <origin>/coroute-32bit.apk (/download/32bit).
APK_URL=
APK_ARM32_URL=

# App version gate (versionCode N from pubspec "x.y.z+N"); raise MIN_APP_BUILD only when an old build must stop working
MIN_APP_BUILD=60
LATEST_APP_BUILD=76
# Public support address (legal pages, receipts, map-data providers). Use a role address, never a personal one.
# Example: support@<your domain>. Empty = the website points riders to Profile > Help > Send feedback in the app.
SUPPORT_EMAIL=
# 3.57 E-mail studio: postal address printed in every marketing e-mail footer (sender identity). Real campaigns and
# automation rules are refused until it is set; test sends show a placeholder. [OWNER TO FILL]
MAIL_POSTAL_ADDRESS=
# Security reports (/.well-known/security.txt and /security). Empty = SUPPORT_EMAIL.
# SECURITY_CONTACT=security@example.com

# Group tracking and timeline (per-convoy settings override these defaults)
TRACK_RETENTION_DAYS=90
TRACK_MAX_POINTS=120
STOP_RADIUS_M=50
STOP_EXIT_M=60
OFF_ROUTE_M=300
OFFLINE_ALERT_MIN=5
STATIONARY_ALERT_MIN=20
REACH_RADIUS_M=150

# Rider safety (3.14). Defaults shown; change only if needed.
# INCIDENT_FROM_KMH=40            # possible incident: a stop from this speed or more ...
# INCIDENT_STOP_KMH=5             #   ... to this speed or less ...
# INCIDENT_STOP_WITHIN_S=15       #   ... within this many seconds ...
# INCIDENT_STILL_S=120            #   ... then still this long ...
# INCIDENT_STILL_RADIUS_M=40      #   ... within this radius ...
# INCIDENT_STOP_NEAR_M=300        #   ... and not this close to a planned stop or the destination
# INCIDENT_NEAREST=2              # nearest riders asked to check, besides the lead
# INCIDENT_GROUP_NEAR_M=150       # stopped with another slow rider this close (red light, toll queue) ...
# INCIDENT_STILL_GROUP_S=300      #   ... then the still time is this long instead
# NO_SIGNAL_ESCALATE_MIN=10       # no signal this long after riding fast: the lead is told
# NO_SIGNAL_MIN_KMH=30
# ROSTER_PER_MIN=6                # emergency SMS roster requests per rider per minute
# ROSTER_VALID_H=12
# SMS_MAX_RECIPIENTS=10           # texts per SOS from a phone (Android limits bulk SMS)
# CLIENT_ID_CACHE=1000            # outbox dedupe entries kept per convoy
# CLIENT_ID_TTL_H=6
# SOS_RESPONDERS_MAX=50
# MEDICAL_ALLERGIES_MAX=120
# MEDICAL_NOTES_MAX=200

# Rider safety network and rider discovery (3.15). Defaults shown; change only if needed.
# SAFETY_NET_ENABLED=1            # 0: no nearby-rider requests or accident warnings (own-group SOS unchanged)
# DISCOVERY_ENABLED=1             # 0: no "group nearby" cards (Public groups only, opt-in)
# DESTINATIONS_ENABLED=1          # v3.58: 0 hides the admin-curated Explore destinations (GET /api/public/destinations answers an empty list)
# EMERGENCY_EXPIRE_MIN=180        # an open emergency with no update for this long closes as EXPIRED
# NET_RADIUS_1_M=5000             # first search radius for nearby riders ...
# NET_RADIUS_2_M=10000            #   ... widened to this when nobody fits
# NET_NOTIFY_MAX=3                # riders asked per search stage (at most NET_PER_GROUP=2 per group)
# NET_REQUEST_TIMEOUT_S=60        # unanswered request: the next rider is asked
# NET_OSRM_PER_INCIDENT=2         # road checks (OSRM table) per emergency ...
# NET_OSRM_PER_MIN=6              #   ... and per minute for the whole gateway (free demo server)
# NET_OSRM_TIMEOUT_MS=3000
# HAZARD_AHEAD_M=6000             # accident warnings to riders up to this far before the point on their road
# HAZARD_MAX_RECIPIENTS=100
# REPORT_DOWN_PER_10MIN=2         # "Rider down here" reports per rider
# ABUSE_FALSE_ALARMS=3            # false alarms in ABUSE_WINDOW_D days that limit external requests (own group never)
# ABUSE_WINDOW_D=30
# DISCOVERY_RADIUS_M=8000
# AUDIT_RETENTION_DAYS=180        # safety audit rows (ids and codes only) are deleted after this

# 3.16 safety round. Defaults shown; change only if needed.
# WEATHER_URL=https://api.open-meteo.com   # weather on the route (free, no key); empty disables it. Allow this host in the firewall.
# WEATHER_CACHE_MIN=30            # one forecast per 0.1 degree cell is shared by every rider for this long
# WEATHER_PER_MIN=20              # upstream weather calls per minute for the whole gateway (over budget: cached cells only)
# WEATHER_USER_PER_MIN=6          # weather checks per rider per minute
# STALE_MIN_S=90                  # a moving rider with no fix for max(this, STALE_FACTOR x the group's usual gap) is reported to the lead
# STALE_FACTOR=3
# SWEEPER_BEHIND_M=300            # a rider this far behind the sweeper (for 60 s) is reported to the sweeper and lead
# BATTERY_LOW_PCT=15              # low battery alert at or under this (not charging) ...
# BATTERY_OK_PCT=25               #   ... closed at this level or when charging
# TOWN_RADIUS_M=1000              # the group's town limit applies this close to the start, planned stops and the destination
# LIVE_LINK_MIN=30                # a live emergency link lives this long
# LIVE_LINK_PER_ALERT=3           # links per alert (one valid at a time)
# HOSPITAL_MAX_WAIT_MS=5000       # the nearest hospital lookup is skipped when the OSM queue would wait longer
# NET_FAR_MAX_ETA_S=900           # after escalation, a rider "far by road" is still asked when their road ETA is under this

# Free OpenStreetMap services used through the gateway cache (leave empty to disable)
GEO_SEARCH_URL=https://nominatim.openstreetmap.org
GEO_ROUTE_URL=https://router.project-osrm.org
# Contact sent to OpenStreetMap services in the User-Agent. Empty = SUPPORT_EMAIL.
GEO_CONTACT=
GEO_CACHE_DAYS=30
GEO_MIN_INTERVAL_MS=1100

# Route Essentials and Ride Guardian (opt in after staging/device validation).
ESSENTIALS_OVERPASS_URL=
GUARDIAN_ENABLED=false
# Exact public HTTPS origin, required when Guardian is enabled.
# PUBLIC_ORIGIN=https://your-public-host
GUARDIAN_PUSH_ENABLED=false
# Configure VAPID only for a validated single-worker push deployment.
# GUARDIAN_VAPID_PUBLIC_KEY=
# GUARDIAN_VAPID_PRIVATE_KEY=
# GUARDIAN_VAPID_SUBJECT=mailto:your-operations-contact

# Push notifications to the Android app (FCM HTTP v1, docs/features_355/push_notifications.md).
# Empty = push off (tokens are still stored). Put the service account key in the secret store,
# never in this file: the whole JSON on one line, or a file path readable only by the gateway.
# FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_FILE=/run/coroute/fcm_service_account.json
# FCM_PROJECT_ID=

# --- Razorpay (subscription payments) ---
# Keep a test and a live pair; RAZORPAY_MODE picks which one new orders use.
# The platform admin can also enter keys and switch mode in the app's admin console
# (saved encrypted in Oracle; those values win over the ones below).
# Webhook: https://<your-domain>/api/subscription/webhook with events payment.captured,
# order.paid, payment.failed, refund.processed (see RUNBOOK "Going live with Razorpay").
# Payments go through Razorpay only: there is no direct UPI VPA / UTR setting.
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# --- Review photos ---
# Private data folder for photos riders attach to trip reviews. Must be OUTSIDE public/ and on
# persistent, backed-up storage; the gateway user needs read/write (created with mode 0700).
# Default when unset: <gateway>/data/review-photos (inside ReadWritePaths of coroute-gateway.service).
# A folder elsewhere must also be added to ReadWritePaths= in the service (ProtectSystem=strict).
# REVIEW_PHOTO_DIR=/opt/coroute/gateway/data/review-photos

# --- Payments switch ---
# Production default is on (unset = true). Set false only on a staging box: plans then activate for free.
# PAYMENTS_ENABLED=true

# --- Web / sessions ---
# Comma-separated browser origins allowed to call the API cross-origin (empty = same origin only).
# CORS_ORIGINS=
# ADMIN_EMAILS=                   # older name of BOOTSTRAP_ADMIN_EMAILS (either works)
# TOKEN_REFRESH_AFTER_HOURS=24    # a token older than this is re-issued on the next /me

# --- Geocoding (extra) ---
# GEO_PHOTON_URL=https://photon.komoot.io   # type-ahead place search (empty disables it)
# GEO_PHOTON_MIN_INTERVAL_MS=250
# GEO_REVERSE_TIMEOUT_MS=8000
# GEO_COUNTRY=in
# GEO_COUNTRY_BBOX=68.0,6.4,97.6,37.1       # lon_min,lat_min,lon_max,lat_max

# --- Emergency SMS / voice gateway (leave empty to disable a provider; never commit real keys) ---
TELEPHONY_PRIMARY_PROVIDER=twilio
TELEPHONY_SECONDARY_PROVIDER=webhook
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_PHONE_NUMBER=            # older name of TWILIO_FROM_NUMBER
TELEPHONY_WEBHOOK_URL=
TELEPHONY_WEBHOOK_TOKEN=
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
AWS_SNS_REGION=ap-south-1
AWS_SNS_TOPIC_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SOS_DEDUPE_MS=60000             # a repeated SOS from the same rider within this window is one alert

