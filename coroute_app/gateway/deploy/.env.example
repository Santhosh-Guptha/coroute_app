# ---------------------------------------------------------------------------
# Two-VM production (docs/PRODUCTION_TWO_VM_RUNBOOK.md). Values marked [Vault] are secrets: never put them in
# this file on a VM; list their OCI Vault secret OCIDs in /etc/coroute/secret_ids.env instead
# (deploy/fetch_secrets.sh writes them to /run/coroute/secrets.env at boot).
# ---------------------------------------------------------------------------
# Node identity and role. live = VM1 (rides, sockets); web = VM2 (website, payments, admin, mirror);
# all = single VM (default). Caddy decides routing; the role decides which node prefers scheduled jobs.
# NODE_NAME=vm1
# GATEWAY_ROLE=all
# Proxies whose X-Forwarded-For is believed (IPs, CIDRs, loopback/linklocal/uniquelocal). Default loopback.
# VM1: loopback   VM2: loopback,<vm1-private-ip>  (VM1's Caddy forwards WEB routes to VM2 over the VCN)
# TRUST_PROXY=loopback

# Scheduled-job leases (src/job_lease.js): one node runs each job, exactly once per interval.
# JOB_LEASE_TTL_MS=60000           # lease life; a dead holder is replaced after this
# JOB_LEASE_HEARTBEAT_MS=15000     # renew / standby poll period
# JOB_LEASE_GRACE_MS=120000        # a node of the non-preferred role waits this long after expiry

# Secret rotation and settings encryption
# [Vault] JWT_SECRET_PREVIOUS=     # optional, during a JWT rotation only: still accepted, never used to sign;
#                                  # clients get a fresh token (X-CoRoute-Token). Remove after the grace period.
# [Vault] SETTINGS_ENCRYPTION_KEY= # openssl rand -base64 32. Encrypts admin-saved Razorpay secrets and signs
#                                  # web-checkout links (independent of JWT_SECRET). Legacy values are migrated.
# 3.57 sessions & security (docs/features_355/sessions_and_security.md). SAME values on both VMs.
# [Vault] DATA_ENC_KEY=            # openssl rand -base64 32. AES-256-GCM field encryption at rest (phones, emergency
#                                  # contact, Medical ID, 2-step secrets). Without it those fields stay plaintext.
# DATA_ENC_KEY_ID=k1               # id stored with every value; change it with every new DATA_ENC_KEY
# [Vault] DATA_ENC_KEYS_PREVIOUS=  # "k0:<base64>" older keys during a rotation (read only; values are re-encrypted lazily)
# [Vault] BLIND_INDEX_KEY=         # openssl rand -base64 32. Keyed hashes (session IP hashes, device fingerprints)
# ACCESS_TOKEN_TTL_MIN=15          # short access tokens (app >= 10025, website, consoles)
# SESSION_APP_IDLE_DAYS=30         # app sessions end after this long unused (never during a ride)
# SESSION_APP_ABSOLUTE_DAYS=60     # extended while riding
# SESSION_WEB_IDLE_MIN=60
# SESSION_WEB_ABSOLUTE_DAYS=7
# SESSION_ADMIN_IDLE_MIN=30        # /admin and /operator
# SESSION_ADMIN_ABSOLUTE_HOURS=12
# REFRESH_REUSE_GRACE_SEC=60
# REAUTH_WINDOW_MIN=10
# LOGIN_LOCK_THRESHOLD=10          # wrong passwords before a lock (15 min, doubling up to 24 h)
# LOGIN_LOCK_MINUTES=15
# PASSWORD_RESET_TTL_MIN=30
# ADMIN_MFA_ENFORCE=all            # round 4 default. all: admin API needs a 2-step session from app >= 10025 / web
#                                  # consoles; builds < 10025 keep 'web'. strict: every client. web | off.
# HSTS_MAX_AGE=31536000            # gateway header; Caddy sets its own per host (ramp-up: RUNBOOK "HSTS")
# HSTS_PRELOAD=false
# ---- round 4 (docs/features_355/sessions_and_security.md §9-§12) ----
# RIDE_LOCK=on                     # off = no sign-in block during a ride (rollback switch only)
# RIDE_LOCK_STALE_MIN=10           # a riding phone not seen (HTTP or socket) for this long no longer locks
# EMAIL_CODE_TTL_MIN=10            # e-mailed one-time codes (ride lock override, e-mail 2-step)
# EMAIL_CODE_MAX_TRIES=5
# REGISTER_VERIFY_TTL_HOURS=24     # sign-up confirmation link
# REGISTER_PURGE_DAYS=7            # sign-ups never confirmed are removed
# REGISTER_VERIFY_LEGACY=verify    # builds < 10025: verify (readable message, no token) | allow (old 201 + token / 409)
# MODERN_APP_BUILD=10025           # builds below are "legacy" for the round 4 compatibility rules
# DELETE_CONFIRM_TTL_MIN=30        # account deletion link e-mailed to builds < 10025 without a password
# WS_AUTH_TIMEOUT_MS=5000          # a socket without ?token= must send { type: AUTH, token } within this time

# Password hashing (src/password_hash.js): scrypt on the threadpool; legacy bcrypt verified in a worker thread
# and re-hashed at the next sign-in. N=2^15 (~100 ms, 32 MiB per hash).
# PASSWORD_SCRYPT_N=32768
# PASSWORD_SCRYPT_R=8
# PASSWORD_SCRYPT_P=1
# PASSWORD_HASH_CONCURRENCY=2      # concurrent hashes (each holds a threadpool thread + 32 MiB)
# PASSWORD_BCRYPT_WORKERS=1        # worker threads for legacy bcrypt hashes (exit when idle)

# Live mirror between the two gateways (src/mirror.js). Off unless MIRROR_LISTEN_HOST or MIRROR_PEER_URL is set.
# MIRROR_LISTEN_HOST=<vm1-private-ip>     # this VM's private IP (VM2: <vm2-private-ip>); port 3101 open to the peer only
# MIRROR_LISTEN_PORT=3101
# MIRROR_PEER_URL=ws://<vm2-private-ip>:3101/mirror   # the other VM (VM2: ws://<vm1-private-ip>:3101/mirror)
# [Vault] MIRROR_KEY=              # 32+ random chars, the same on both VMs (openssl rand -base64 48)
# MIRROR_ACK_TIMEOUT_MS=400        # durable events (SOS ...) wait this long for the peer's ack
# MIRROR_HANDBACK_DELAY_MS=15000   # VM1 healthy again: riders move back after this delay ...
# MIRROR_HANDBACK_PER_SEC=25       #   ... at this rate
# MIRROR_STARTUP_WAIT_MS=3000
# MIRROR_SYNC_TIMEOUT_MS=30000
# LIVE_RIDER_CAP=0                 # riders with a live socket across both VMs before new ones get 503 SERVER_BUSY.
#                                  # Default unset / 0 = no cap. Owner-facing suggestion (not automatic): 2500 on the two
#                                  # 1 GB micros, the same value on both VMs; riders already riding are never refused.
#                                  # Raise in 25 % steps while peak event loop lag stays below 100 ms (admin > Servers).

# Review photos and backups (OCI Object Storage through pre-authenticated requests)
# REVIEW_PHOTO_STORE=disk          # disk | par
# [Vault] REVIEW_PHOTO_PAR_URL=    # bucket PAR (read/write), ends with /o/
# [Vault] BACKUP_PAR_URL=          # backup bucket PAR (write + list), ends with /o/
# [Vault] BACKUP_ENCRYPTION_KEY=   # openssl rand -base64 32; ALSO keep a copy outside OCI (password manager)
# BACKUP_CRITICAL_EVERY_MINUTES=60
# BACKUP_FULL_HOUR_UTC=21
# BACKUP_RETENTION_DAYS=30
# TRACK_DETAIL_DAYS=14             # full-detail GPS points kept this long (then thinned)

# ---- iPhone download links (website) ----
# Leave all empty until the iOS app is on TestFlight or the App Store: the website then shows Android only.
# Set one (App Store wins) and restart: "Download for iOS" buttons and iOS text appear on every page.
APP_STORE_URL=
IOS_TESTFLIGHT_URL=
IOS_IPA_URL=

# ---- Round 4: road & safety intelligence (src/intel/, docs/intelligence/ROAD_AND_SAFETY_INTELLIGENCE.md) ----
# Collection happens ONLY for riders who turned on "Help make roads safer" (opt-in). Warnings are read by everyone.
# INTEL_ENABLED=true              # master switch (collection + intel API); off = empty answers, nothing collected
# INTEL_KILL=false                # emergency kill switch: stops collection and aggregation at once, reads answer empty
# INTEL_K_MIN=5                   # k-anonymity: a cell is shown only once this many distinct riders contributed
# INTEL_RAW_DAYS=90               # raw event rows are deleted after this many days
# INTEL_HALF_LIFE_DAYS=90         # aggregates decay with this half-life
# INTEL_TRIM_M=300                # first / last metres of every ride never counted
# CRASH_BRAIN_MODE=shadow         # shadow (log only) | approved (MASTER_ADMIN approvals reach phones) | off
# FUEL_GAP_KM=80                  # no-fuel gap warning above this many km
# ROUTER_KIND=osrm                # osrm | valhalla (owner-gated; Valhalla needs the A1: deploy/valhalla/README.md)
# OSRM_TABLE_URL=https://router.project-osrm.org  # with ROUTER_KIND=valhalla: the safety network's road-distance check stays on OSRM
# INTEL_MAX_ACCUMULATORS=500      # memory bound: riders counted at once per node
# INTEL_MAX_CELLS_PER_RIDE=200    # memory bound: a ride is flushed as a row after this many cells
# INTEL_JOB_MAX_CELLS=2000        # cell writes per aggregation run (job lease holder only)
# INTEL_JOB_EVERY_MIN=5           # aggregation interval
# INTEL_CACHE_TTL_S=600           # read cache per geohash-4 tile
# INTEL_HASH_KEY=                 # SECRET (OCI Vault, >= 32 random chars): keyed monthly rider hash. Unset = derived from JWT_SECRET (warning).

# ---- v3.56 performance and operations (docs/infra/INFRASTRUCTURE_PLAN_v3.56.md) ----
# GATEWAY_ROLE=standby               # DR node (vm3): boots, no scheduled jobs, /api/health/live 503
# METRICS_ALLOW=loopback             # GET /metrics (Prometheus text): these IPs/CIDRs only (Caddy also 404s it publicly)
# METRICS_TOKEN=                     # SECRET (Vault) if a remote scraper needs /metrics with a Bearer token
# HTTP_KEEPALIVE_MS=75000            # above Caddy's 60 s upstream keep-alive
# SHUTDOWN_DRAIN_MS=0                # vm1/vm2: 15000 (503 to the NLB first, then RECONNECT); needs TimeoutStopSec=45
# HEALTH_DB_CACHE_MS=2000            # /api/health reuses a good database ping this long
# NODE_COMPRESSION=on                # off behind Caddy (Caddy compresses with zstd/gzip off the event loop)
# ORACLE_MAX_INFLIGHT=16             # database calls in flight per node (10 recommended on the micros); 0 = unlimited
# ORACLE_MAX_QUEUE=2000              # calls waiting beyond that fail fast (503)
# ORACLE_PRIORITY_COLLECTIONS=alerts,auth_sessions,leases   # never wait for a slot (SOS, sign-in/refresh, job leases)
# LOAD_SHED=on                       # on | off | force (drills); non-essential reads only, never SOS/auth/rides
# LOAD_SHED_LAG_MS=250               # shed while the event loop lag is above this
# LOAD_SHED_MAX_INFLIGHT=200         #   ... or more HTTP requests than this are in flight
# LOAD_SHED_HEAP_RATIO=0.9           #   ... or the heap is fuller than this share of its limit
# LOAD_SHED_DB_QUEUE=200             #   ... or more database calls than this are waiting
# LOAD_SHED_HOLD_MS=5000             # keep shedding this long after the last overload sign
# LOAD_SHED_RETRY_AFTER_S=15         # Retry-After of a shed answer (503)
# LOAD_SHED_PATHS=                   # extra sheddable rules, comma separated: "GET /api/x"
# WS_POS_MIN_MS=800                  # one position per rider per window in rooms of any size (SOS never waits)
# WS_POS_BATCH=on                    # RIDER_UPDATES batch frames to apps that announce 'posbatch1'
# WS_BATCH_LARGE=on                  # rooms above WS_COALESCE_ABOVE (20) flush every WS_COALESCE_MS (500)
# WS_GATE_TTL_MS=120000              # telemetry / ping re-check the cached account at most this often
# WS_HEARTBEAT_MS=30000              # socket ping interval
# WS_DEFLATE=off                     # permessage-deflate: off on the micros (measured +240 KB RSS per socket)
# --- Round 8 realtime (docs/quality/ROUND8_REALTIME_NOTES.md): abuse limits, pos2 frames, interest management, shards
# WS_MAX_CONN_PER_IP=50              # open sockets per client IP (NAT-friendly; 0 = off). Over it: HTTP 429 at the upgrade
# WS_CONN_PER_MIN_PER_IP=120         # new sockets per minute per client IP (0 = off)
# WS_CONN_PER_MIN_PER_USER=30        # new sockets per minute per account (close 4429 TOO_MANY_CONNECTS; 0 = off)
# WS_RL_POS=5/20                     # per-socket bucket "rate per s/burst": TELEMETRY, P2, binary telemetry (drops silently)
# WS_RL_CHAT=2/10                    # CHAT, CHAT_REPORT, PR_*, ROAD_WARN* (ERROR 429 "Slow down.")
# WS_RL_JOIN=0.2/6                   # JOIN, LEAVE
# WS_RL_PING=1/10                    # PING, AUTH, BYE
# WS_RL_OTHER=10/40                  # every other non-safety message (SOS / alerts are never counted)
# WS_RL_KICK_DROPS=60                # dropped messages per 10 s before the socket is closed 4429 RATE_LIMIT_<CLASS>
# WS_JOIN_FAIL_MAX=8                 # refused JOINs per minute per socket before close 4429 JOIN_FLOOD
# WS_SOS_FLOOR_PER_10S=10            # the per-socket SOS budget never goes below this; above it the open alert is echoed
# WS_IDLE_MS=7200000                 # a socket outside a ride that sent nothing this long closes 4408 (0 = off)
# WS_SLOW_READER_MS=60000            # a socket whose send buffer stays above WS_OUT_SOFT_BYTES this long closes 1013
# WS_POS2=on                         # advertise 'pos2' (compact P2 / RU2 position frames) in HELLO.features
# WS_INTEREST=on                     # interest management in big rooms (nearest riders at full rate, the rest every 5 s)
# WS_INTEREST_ABOVE=30               # ... in rooms with more sockets than this
# WS_INTEREST_NEAR_K=20              # ... nearest riders at full rate (plus lead, sweeper, owner, open alerts)
# WS_INTEREST_FAR_MS=5000            # ... everyone else's latest position at most this often
# WS_INTEREST_RECOMPUTE_MS=2000      # ... nearest set recomputed at most this often per socket
# MIRROR_SOS_PENDING_TTL_MS=600000   # an announced SOS (SP) not delivered within this while the link is up is forgotten
# SHARDS=1                           # stage 4 group placement: number of live pairs (1 = off; prepared, not enabled)
# SHARD_PAIRS=a,b                    # pair names (deploy/gen_caddy_shards.js); consistent hash of the group id
# SHARD_SELF=a                       # this node's pair (GET /api/shard answers "here" or not)
# INTEL_CONSENT_TTL_MS=60000         # cached road-data consent when the mirror is down (300000 at > 3k riders)

# ---- Round 6: variables that were read by the gateway but not listed here (defaults shown; change only if needed) ----
# Sign-in and staff
# GOOGLE_WEB_CLIENT_ID=              # website Google sign-in button (the Web client id); empty = no Google button on /signin
# STAFF_EMAILS=                      # comma list of staff accounts (with BOOTSTRAP_ADMIN_EMAILS): left out of rider stats and audiences
# LOGIN_DELAY_STEP_MS=400            # extra delay per failed sign-in of an account (brute-force brake)
# OPERATOR_REVIEW_EMAIL=             # where new operator / club applications are mailed; empty = SUPPORT_EMAIL
# Outgoing e-mail (src/mailer.js). E-mail features stay off until SMTP_HOST and MAIL_FROM are set.
# SMTP_HOST=                         # e.g. smtp.<provider>.example
# SMTP_PORT=587                      # 465 = implicit TLS
# SMTP_SECURE=                       # true | false; empty = true on port 465, STARTTLS otherwise
# SMTP_USER=
# [Vault] SMTP_PASS=                 # SECRET
# MAIL_FROM=                         # "CoRoute <no-reply@your-domain.example>"
# MAIL_REPLY_TO=                     # optional Reply-To
# LIFECYCLE_EMAIL_RATE=5             # welcome / ride summary e-mails per second (queue worker)
# OFFER_EMAIL_RATE=5                 # campaign e-mails per second
# TRIP_MEMORY_DELAY_MIN=10           # minutes after a ride before its summary e-mail is queued
# Push campaigns
# PUSH_CAMPAIGN_RATE=50              # pushes per second per campaign
# PUSH_NEWS_DAILY_CAP=2              # news / offer pushes one rider may get per day
# PUSH_IMAGE_DIR=                    # disk folder for campaign images (default data/push-images; REVIEW_PHOTO_STORE=par uses Object Storage)
# Server SOS text providers
# [Vault] MSG91_AUTH_KEY=            # SECRET: MSG91 (India DLT route)
# TWILIO_MESSAGING_SERVICE_SID=      # alternative to TWILIO_FROM_NUMBER
# [Vault] SMS_WEBHOOK_TOKEN=         # SECRET (16+ chars): path token of POST /api/sms/receipts/:provider/:token
# Payments
# RAZORPAY_WEBHOOK_URL=subscription  # which webhook path Razorpay calls: subscription | membership
# Diagnostics logs
# DIAG_LOG_STORE=                    # par = Object Storage (DIAG_LOG_PAR_URL or REVIEW_PHOTO_PAR_URL); empty = the database
# [Vault] DIAG_LOG_PAR_URL=          # SECRET: pre-authenticated request URL, ends with /o/
# Map places
# POI_OVERPASS_URL=                  # Overpass endpoint for map places; empty = ESSENTIALS_OVERPASS_URL
# Rider safety network / public ride
# NET_PUBLIC_RADIUS_M=2000           # nearby-help radius for public riders (200..5000)
# PUBLIC_RIDE_ENABLED=1              # 0 turns the public ride feature off on this server
# PUBLIC_RIDE_TICK_MS=30000          # how often public ride state is evaluated
# PUBLIC_RIDE_SNAP_M=500             # coarse position grid shared with other riders
# PUBLIC_RIDE_PARK_MIN=10            # minutes standing still before a rider counts as parked
# PUBLIC_RIDE_REQUEST_MIN=10         # minutes a ride-along request stays open
# PUBLIC_RIDE_CHANNEL_MIN=30         # minutes a conversation channel stays open
# PUBLIC_RIDE_BLOCK_DAYS=30          # how long a block between two riders lasts
# PUBLIC_RIDE_SUSPEND_BLOCKS=3       # blocks by different riders before an automatic suspension
# PUBLIC_RIDE_SUSPEND_DAYS=7         # length of that suspension
# ROAD_WARN_CONFIRMS=2               # riders who must confirm a road warning before others see it
# ROAD_WARN_NEAR_M=5000              # who is asked to confirm
# ROAD_WARN_REACH_M=20000            # how far a confirmed warning is shown
# ROAD_WARN_MERGE_M=1000             # warnings closer than this are one warning
# Tracks
# TRACK_BATCH_FLUSH_MS=250           # track points are written in batches this often
# TRACK_BATCH_MAX=50                 # ... or when this many documents wait
# TRACK_SIMPLIFY_TOLERANCE_M=5       # Douglas-Peucker tolerance for stored tracks
# WebSocket limits
# LIVE_REJOIN_GRACE_MS=900000        # a rider active in a ride within this window may rejoin above LIVE_RIDER_CAP
# VOICE_MAX_FPS=100                  # voice frames per second per rider
# Round 8 voice relay (src/voice_relay.js, docs/features_355/voice_clarity.md)
# VOICE_MAX_BYTES_PER_SEC=48000      # voice bytes per second per speaker (PCM16 16 kHz is 32000; Opus ~3000)
# VOICE_DROP_BYTES=16384             # a socket with more unsent bytes gets no voice frame (lowest priority; never queued)
# VOICE_FAIR_HOLD_MS=20000           # a group floor held this long yields to the next rider who presses talk (0 = off)
# VOICE_CAPS_GRACE_MS=3000           # a socket silent on VOICE_CAPS this long counts as an old build (group uses PCM)
# VOICE_RELAY_MODE=inprocess         # inprocess (default) | process: separate voice process serving /voice
# VOICE_RELAY_PORT=3010              # port of the voice process (process mode); Caddy: deploy/caddy/voice_relay.caddy
# VOICE_RELAY_HOST=127.0.0.1         # bind address of the voice process (keep loopback: Caddy proxies /voice)
# ---- Round 10 offline link (src/mesh_bridge.js, docs/features_355/offline_long_range_link.md) ----
# MESH_KEY_SECRET=                   # secret for the per-ride mesh group keys (MESH_KEY); empty = derived from JWT_SECRET.
#                                    # Set it on BOTH nodes of a two-node deployment (same value), never commit it.
# MESH_BRIDGE_PER_SEC=40             # non-SOS mesh frames a bridge phone may forward per second (SOS frames: no limit)
# WS_COALESCE_ABOVE=20               # rooms above this size coalesce positions
# WS_COALESCE_MS=500                 # ... into one flush per this window
# WS_POSITION_DROP_BYTES=262144      # a slow socket above this buffer drops positions (never alerts)
# WS_OUT_SOFT_BYTES=131072           # soft limit before positions are thinned
# WS_MAX_BUFFERED_BYTES=4194304      # a socket above this buffer is closed
# WS_MAX_SOCKETS_PER_USER=8          # open sockets per account
# Road & safety intelligence
# CRASH_BRAIN_MIN_LABELS=200         # labelled crash reports needed before training (never below 200)
# Route weather (src/weather_met.js, round 6 app agent)
# WEATHER_PROVIDER=                  # metno (default: MET Norway Locationforecast) | open-meteo
# WEATHER_MET_URL=                   # MET-compatible base URL; empty = https://api.met.no (or WEATHER_URL when it is not Open-Meteo's)
# ---- Round 6 business analytics and the "Servers" admin page (docs/intelligence/BUSINESS_ANALYTICS.md) ----
# BUSINESS_ANALYTICS=on              # off = no nightly computation, no app-open counting, no weekly summary
# BUSINESS_PAGE_SIZE=200             # documents read per page by the nightly job (20..500)
# BUSINESS_PAGE_PAUSE_MS=40          # pause between pages (keeps the nightly job gentle on the database and the CPU)
# BUSINESS_MAX_RIDERS=100000         # riders with rides held in memory during the nightly job (about 100 bytes each)
# BUSINESS_MAX_USERS=300000          # accounts scanned per night; beyond it the pages say "partial"
# PEER_METRICS_URL=                  # the other node's /metrics for the Servers page; empty = http://<mirror peer>:PORT/metrics
#                                    # (the peer must allow it: METRICS_ALLOW with this node's private IP, or METRICS_TOKEN on both)
# NODE_MEMORY_MB=1024                # RAM of this VM, for the memory colour on the Servers page
# ---- Round 7 road cells: curve prediction and speed limits on the phone (docs/features_355/curve_and_speed_limit.md) ----
# ROAD_CELLS_OVERPASS_URL=           # Overpass endpoint for road geometry; empty = POI_OVERPASS_URL, then ESSENTIALS_OVERPASS_URL
#                                    # (the public instance asks apps to stay small or run their own: keep the budgets below, or point this at your own Overpass)
# ROAD_CELLS_TTL_DAYS=30             # a cell is refreshed after this many days (served stale up to 180 days meanwhile)
# ROAD_CELLS_MEM_MB=12               # memory for cached cells on this node (gzip bytes, LRU; 1..64)
# ROAD_CELLS_UPSTREAM_PER_MIN=6      # Overpass calls per minute from this node
# ROAD_CELLS_UPSTREAM_PER_DAY=2000   # Overpass calls per day from this node (the public instance's fair use is about 10,000 a day in total)
# ROAD_CELLS_CONCURRENCY=1           # Overpass calls at the same time from this node (1..4)
# ROAD_LIMIT_K_MIN=3                 # riders who must agree before a "wrong limit" correction applies (never below 3)
# ---- Round 8 background job queue and workers (docs/features_355/job_queue.md, docs/quality/ROUND8_JOBS_NOTES.md) ----
# JOBS_QUEUE=off                     # on = e-mails, push fan-out, road fetches, photo clean-up and nightly batches go to the
#                                    # job queue (SODA collection job_queue) and are worked by workers; off = inline as before
# WORKER_INPROCESS=auto              # auto | on | off: this gateway also works jobs. auto/on on GATEWAY_ROLE all|web; on a live
#                                    # node only while no other worker has a heartbeat (and never with JOBS_SEPARATE_WORKER=on)
# JOBS_SEPARATE_WORKER=off           # on (set on the LIVE node once coroute-worker runs on vm2/vm5): the live node never works jobs
# WORKER_TYPES=                      # job families this process works: email,push,roads,photo,batch (empty or all = every family)
# WORKER_CONCURRENCY=email:4,push:4,roads:1,photo:2,batch:1   # jobs at the same time per family (before the capacity factor)
# WORKER_MAX_CONCURRENCY=16          # jobs at the same time in this process, all families together
# WORKER_INPROCESS_SHARE=0.5         # an in-process worker uses this share of WORKER_CONCURRENCY (the gateway comes first)
# WORKER_DRAIN_MS=25000              # separate worker on SIGTERM: wait this long for running jobs, then hand them back
#                                    # (an in-process worker waits at most 5 s: the gateway's TimeoutStopSec)
# WORKER_HEALTH_PORT=8091            # gateway/worker.js: GET /health, /health/queue (503 above the alert thresholds), /metrics
# WORKER_HEALTH_HOST=127.0.0.1       # bind address of that endpoint (keep it private: loopback or the VCN address)
# JOBS_POLL_MIN_MS=250               # poll interval while there is work
# JOBS_POLL_MAX_MS=5000              # poll interval after idle backoff (a job enqueued on the same node wakes the worker at once)
# JOBS_CLAIM_BATCH=4                 # rows claimed per poll (keep small: the free database has 20 sessions)
# JOBS_MAX_PAYLOAD_BYTES=8192        # larger payloads are refused (jobs carry ids, not data)
# JOBS_DONE_TTL_HOURS=24             # finished rows (no payload) are kept this long: the idempotency window of their key
# JOBS_DEAD_TTL_DAYS=14              # dead letters are kept this long (retry / discard: /api/admin/jobs/dead)
# JOBS_SECURITY_FALLBACK_MS=10000    # a security-code e-mail no worker claimed within this time is sent inline by the gateway
# JOBS_SEAL_KEY=                     # [Vault] 32 random bytes, base64: seals security-code payloads in the queue; empty = derived from JWT_SECRET
# JOBS_LAG_WARN_MS=40                # capacity: event-loop lag p99 that halves new work ...
# JOBS_LAG_HIGH_MS=100               # ... and that stops taking new work (running jobs finish)
# JOBS_LOAD_WARN=1.0                 # capacity: 1-minute load average per core that halves new work ...
# JOBS_LOAD_HIGH=1.5                 # ... and that stops taking new work
# JOBS_MEM_WARN_PCT=20               # capacity: available memory % that halves new work ...
# JOBS_MEM_LOW_PCT=10                # ... and that stops taking new work (the database budget, ORACLE_MAX_INFLIGHT, is checked too)
# JOBS_ALERT_OLDEST_S=300            # alert when the oldest due job has waited longer (admin API, worker /health/queue)
# JOBS_ALERT_DEAD=20                 # alert at this many dead letters
