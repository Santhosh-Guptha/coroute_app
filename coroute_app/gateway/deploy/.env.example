# ---------------------------------------------------------------------------
# CoRoute gateway configuration.  Copy to /etc/coroute/gateway.env (chmod 600).
# Nothing in this file is ever shipped inside the mobile app.
# ---------------------------------------------------------------------------
NODE_ENV=production
HOST=127.0.0.1          # Caddy terminates TLS and proxies to this port
PORT=3000

# Oracle Autonomous Database (Always Free) — ORDS SODA endpoint of a DEDICATED
# low-privilege schema (see RUNBOOK §2). Never use ADMIN here.
ORACLE_SODA_URL=https://<your-adb-host>.adb.ap-hyderabad-1.oraclecloudapps.com/ords/coroute/soda/latest
ORACLE_USER=COROUTE
ORACLE_PASSWORD=<strong-password>
ORACLE_TIMEOUT_MS=6000

# 64+ random chars:  openssl rand -base64 48
JWT_SECRET=<random-secret>
JWT_TTL_DAYS=30

# Google Sign-In: the OAuth *client IDs* whose ID tokens we accept (Android + Web ids, comma separated)
GOOGLE_CLIENT_IDS=87798956679-ivggpbpote5cf2cvi8mtg8gja3r1sfve.apps.googleusercontent.com

# Seeds the FIRST admin only. After that, manage roles via PATCH /api/admin/users/:userId/role
BOOTSTRAP_ADMIN_EMAILS=santhoshbukka5@gmail.com

# Housekeeping (keeps accounts + trip records forever; strips GPS traces only)
RETENTION_ENDED_CONVOY_DAYS=90
RETENTION_VOICE_LOG_DAYS=7
RETENTION_STALE_CONVOY_HOURS=36
RETENTION_RUN_EVERY_MINUTES=360
DB_KEEPALIVE_EVERY_MINUTES=720

# Abuse and free-tier guards (defaults shown; change only if needed)
# USER_GATE_TTL_MS=30000          # how long an account check is cached (hold/block/delete apply at once anyway)
# JOIN_WINDOW_MIN=15               # wrong join codes: window in minutes
# JOIN_MAX_FAILURES=10             #   per rider in that window
# JOIN_MAX_FAILURES_PER_IP=30      #   per network in that window
# MAX_CONVOY_RIDERS=50             # riders in one convoy (also shown on the website)
# TRIP_MAX_TRAIL_POINTS=4000       # trail points kept per uploaded trip
# MAX_TRIPS_PER_USER=500
# TRIP_MAX_BYTES=1048576           # largest trip upload
# PV_MAX_REFERRERS=50              # website analytics: referrer hosts per page per day
# WS_ACTIONS_PER_SEC=10            # route/status/settings socket messages per second
# WS_ALARMS_PER_10S=3              # WAIT and SOS per 10 seconds

# Voice relay guards
VOICE_MAX_FRAME_BYTES=16384
VOICE_STREAM_IDLE_MS=1500
VOICE_MAX_STREAM_MS=60000

# Website
# Public origin used in canonical/og/sitemap URLs (optional; derived from the request Host when empty)
PUBLIC_ORIGIN=
# Where /download sends people. Set PLAY_STORE_URL once the Play listing is live; until then the APK URL is used.
PLAY_STORE_URL=
# Empty = the APKs this gateway serves: <origin>/coroute.apk (64-bit) and <origin>/coroute-32bit.apk (/download/32bit).
APK_URL=
APK_ARM32_URL=

# App version gate (versionCode N from pubspec "x.y.z+N"); raise MIN_APP_BUILD only when an old build must stop working
MIN_APP_BUILD=60
LATEST_APP_BUILD=71
SUPPORT_EMAIL=santhoshbukka5@gmail.com

# Group tracking and timeline (per-convoy settings override these defaults)
TRACK_RETENTION_DAYS=90
TRACK_MAX_POINTS=120
STOP_RADIUS_M=50
STOP_EXIT_M=60
OFF_ROUTE_M=300
OFFLINE_ALERT_MIN=5
STATIONARY_ALERT_MIN=20
REACH_RADIUS_M=150

# Free OpenStreetMap services used through the gateway cache (leave empty to disable)
GEO_SEARCH_URL=https://nominatim.openstreetmap.org
GEO_ROUTE_URL=https://router.project-osrm.org
GEO_CONTACT=santhoshbukka5@gmail.com
GEO_CACHE_DAYS=30
GEO_MIN_INTERVAL_MS=1100
