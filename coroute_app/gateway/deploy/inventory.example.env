# CoRoute VM inventory (v3.56). Copy to inventory.local.env (git-ignored) and fill in the real values there.
# NEVER put real IP addresses, OCIDs, tenancy e-mails or key paths into a tracked file (this one included).
# Read by deploy/release.sh, deploy/host/apply.sh (--inventory), deploy/dr/*.sh and the owner's release agent.

# SSH aliases (from ~/.ssh/config on the owner's machine; release.sh uses them as-is)
VM1_SSH=vm1            # realtime primary   (tenancy 1, E2.1.Micro)
VM2_SSH=vm2            # web + hot mirror    (tenancy 1, E2.1.Micro)
VM3_SSH=vm3            # DR standby, watchdog, offsite backups (tenancy 2)
VM4_SSH=vm4            # staging / canary / load runner (tenancy 2)
VM5_SSH=vm5            # A1.Flex worker when capacity is granted (tenancy 2)

# Private addresses inside the tenancy-1 VCN (Caddy route split, mirror link, firewall peer rules)
VM1_PRIVATE_IP="<vm1-private-ip>"
VM2_PRIVATE_IP="<vm2-private-ip>"
# Public addresses (watchdog per-node checks, DR DNS switch, ADB ACL, firewall rules for cross-tenancy links)
VM1_PUBLIC_IP="<vm1-public-ip>"
VM2_PUBLIC_IP="<vm2-public-ip>"
VM3_PUBLIC_IP="<vm3-public-ip>"
VM4_PUBLIC_IP="<vm4-public-ip>"
VM5_PUBLIC_IP="<vm5-public-ip>"
NLB_PUBLIC_IP="<nlb-reserved-public-ip>"

# Hosts
PUBLIC_HOST=coroute.devmonks.space
LEGACY_HOST=coroute.duckdns.org
STAGING_HOST=staging.coroute.devmonks.space

# Remote layout (defaults match setup_node.sh)
REMOTE_BASE=/opt/coroute
REMOTE_USER=ubuntu
# Release health gates (release.sh)
HEALTH_TIMEOUT_S=90
STAGING_LOAD_RIDERS=300
STAGING_LOAD_SECONDS=30

# ---- Round 6: values the provisioning / hardening scripts used to hard-code (deploy/_inventory.py, _inventory.sh) ----
# OCI identifiers (auto_provision_ampere.py, smart_free_provisioner.py, update_adb_acl.py)
OCI_TENANCY_OCID="<ocid1.tenancy...>"
OCI_COMPARTMENT_OCID="<ocid1.compartment... or the tenancy OCID>"
OCI_REGION="<region, e.g. ap-hyderabad-1>"
OCI_AVAILABILITY_DOMAIN="<availability domain name>"
OCI_VCN_OCID="<ocid1.vcn...>"
OCI_SUBNET_OCID="<ocid1.subnet...>"
OCI_ADB_OCID="<ocid1.autonomousdatabase...>"
OCI_ARM_IMAGE_OCID="<ocid1.image... Ubuntu aarch64>"
OCI_X86_IMAGE_OCID="<ocid1.image... Ubuntu x86_64>"
# OCI API config file (default ~/.oci/config) and the SSH key pair used for new VMs (paths on the owner's machine)
OCI_CONFIG_FILE="<path to the OCI config file>"
VM_SSH_PUBLIC_KEY_FILE="<path to the .pub key installed on new VMs>"
VM_SSH_PRIVATE_KEY_FILE="<path to the matching private key>"
# Extra public addresses allowed in the Autonomous Database ACL (comma separated; the VM public IPs above are added)
ADB_ACL_EXTRA_IPS=""
VCN_CIDR="10.0.0.0/16"
# ORDS SODA endpoint of the gateway schema (setup_new_vm.sh / setup_vm2.sh write it into gateway.env)
ORACLE_SODA_URL="<https://...adb.<region>.oraclecloudapps.com/ords/<schema>/soda/latest>"
# Admin OS accounts created by setup_new_vm.sh (space separated login names)
VM_ADMIN_USERS="<login names>"
# First MASTER_ADMIN e-mail(s) and Google OAuth client ids written into a new VM's gateway.env
BOOTSTRAP_ADMIN_EMAILS="<owner e-mail>"
GOOGLE_CLIENT_IDS="<google oauth client id(s)>"

# Tenancy-2 Object Storage offsite copy: a PAR URL with object write (kept ONLY on vm3, in /etc/coroute/backup.env)
# OFFSITE_PAR_URL=<never here>
