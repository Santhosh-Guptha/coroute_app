# /etc/systemd/system/coroute-secrets.service  (installed by deploy/setup_node.sh)
# Fetches secrets from OCI Vault with the instance principal into /run/coroute (tmpfs, never on disk):
#   /run/coroute/secrets.env  (0600, coroute)  -> coroute-gateway.service
#   /run/coroute/caddy.env    (0600, root)     -> caddy.service (DUCKDNS_TOKEN only)
# Re-fetch after a rotation:  systemctl restart coroute-secrets && systemctl restart coroute-gateway
[Unit]
Description=CoRoute secrets from OCI Vault
Wants=network-online.target
After=network-online.target
Before=coroute-gateway.service caddy.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/coroute/gateway/deploy/fetch_secrets.sh
TimeoutStartSec=180
UMask=0077
# Stopping this unit removes the secrets from /run.
ExecStop=/bin/sh -c 'rm -f /run/coroute/secrets.env /run/coroute/caddy.env'

[Install]
WantedBy=multi-user.target
