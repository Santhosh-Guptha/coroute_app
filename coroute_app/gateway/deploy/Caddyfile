# /etc/caddy/Caddyfile — automatic HTTPS (Let's Encrypt), auto-renewal, HTTP->HTTPS redirect.
# Hostname that resolves to this VM (<vm-public-ip>). Free option: a DuckDNS name (see RUNBOOK §0).
api.coroute.example.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	# WebSocket + REST share the same upstream; Caddy handles the Upgrade automatically.
	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}
