# systemd unit for the Valhalla container on the A1 (install to /etc/systemd/system/, then
# `sudo systemctl daemon-reload && sudo systemctl enable --now coroute-valhalla`).
[Unit]
Description=CoRoute Valhalla motorcycle router (A1 only)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/coroute/valhalla
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
