<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Every permission and why: docs/PLAYSTORE_PERMISSIONS.md (keep both in step). -->
    <!-- Convoy sync, SOS delivery, map tiles; network kind for the tile cache and the phone check. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Round 4: optional "Lock CoRoute with fingerprint or screen lock" (framework BiometricPrompt, API 28+). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Live position for the group, crash/SOS location (precise needed for an SOS). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- "Allow all the time": only during an active ride, after an in-app prominent disclosure
         (permissions screen and phone check). Needs the Play Console location declaration. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <!-- Ride foreground service (flutter_foreground_task): type location, plus microphone while the
         intercom is on. Android 14 needs the per-type permissions below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- Asked once from the phone check / checklist; OEMs kill long rides otherwise. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Android 13+: ride notification, crash alarm, SOS and group alerts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Android 16+: the ride notification as a Live Update (promoted ongoing notification: status bar chip,
         lock screen and always-on display) with the next turn or the group status. Normal permission, nothing
         is asked; riders can turn Live Updates off for CoRoute in Android settings (RideNotification.kt). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>
    <!-- Crash detection keeps the motion sensor running in deep sleep during a ride (AccelStream). -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Crash alarm and alert haptics. -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Push-to-talk intercom and the 1 s microphone test of the phone check (nothing is kept). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Route voice to a Bluetooth helmet headset (SCO). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- ==== Round 10 rescue beacon BEGIN (docs/features_355/rescue_beacon.md; shared with any other
         CoRoute BLE use, e.g. the offline mesh: declare each permission ONCE in this file).
         A down rider's phone advertises a 5-byte rescue id under CoRoute's rescue UUID (no name, no
         position) and responders' phones scan for that UUID only, during an open SOS. Android 12+:
         "Nearby devices" (BLUETOOTH_ADVERTISE / BLUETOOTH_SCAN), the scan never derives location.
         Android 11 and older: the legacy BLUETOOTH / BLUETOOTH_ADMIN (install-time) and, for the
         scan, the location permission CoRoute already has. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s"/>
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false"/>
    <!-- ==== Round 10 rescue beacon END -->
    <!-- ==== Round 10 offline link (docs/features_355/offline_long_range_link.md): uses the SAME Bluetooth entries
         above (declared once): BLUETOOTH_ADVERTISE + BLUETOOTH_SCAN (neverForLocation: the scan only reads CoRoute's
         own mesh beacons, RSSI is used for link quality, never to locate anyone) + BLUETOOTH_CONNECT for the
         rider-to-rider links (GATT / L2CAP) on Android 12+; legacy BLUETOOTH / BLUETOOTH_ADMIN + the existing location
         permission on Android 11 and older. Nothing new is declared for it. ==== -->
    <!-- flutter_local_notifications: re-schedules plan expiry reminders after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Rider safety: crash alarm over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- 3.57 phone-first emergency texts: an SOS or an unanswered crash alarm texts the rider's
         emergency contacts from their own SIM without a tap (EmergencyTexts.kt). Asked after an
         in-app prominent disclosure; Play "Physical safety / emergency alerts" exception with the
         Permissions Declaration Form (docs/handbook/compliance/play_store_compliance.md).
         Denied: the SOS text opens prefilled in the messages app instead. No READ_SMS,
         RECEIVE_SMS or READ_PHONE_STATE: the default SMS SIM is used without listing SIMs. -->
    <uses-permission android:name="android.permission.SEND_SMS"/>
    <!-- 3.55: lets the rider allow CoRoute's "Critical ride alerts" channel through Do Not Disturb
         (Settings > Do Not Disturb access; normal permission, nothing is asked at install). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
    <!-- v3.57 build health (docs/release/PLAY_BUILD_HEALTH_PLAN_v3.57.md section 4): permissions CoRoute
         never uses, removed if any library's manifest adds them (no effect when none does). Decisions:
         docs/release/R8_KEEP_RULES_v3.57.md "Permissions".
         - AD_ID: no ads and no Firebase Analytics (FCM only); the Play advertising ID declaration is "No".
         - READ_PHONE_STATE: never requested. PhoneCallChannel detects calls from the audio mode without it;
           SMS uses the default SMS SIM without listing SIMs.
         - READ/WRITE_EXTERNAL_STORAGE: nothing is written to or read from shared storage. Photos come
           from the system photo picker, the diagnostics file is shared from the app cache.
         - CAMERA: "Take a new photo" uses the camera app (ACTION_IMAGE_CAPTURE via image_picker), which
           needs no permission. Declaring CAMERA would even break it: Android then refuses
           ACTION_IMAGE_CAPTURE until the permission is granted. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove"/>
    <!-- SEND_SMS implies telephony: without this Play would hide CoRoute from tablets without a SIM. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false"/>

    <application
        android:label="CoRoute"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Invite links: coroute://join/CODE -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="coroute" android:host="join"/>
            </intent-filter>
            <!-- Navigation return callback: coroute://cockpit -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="coroute" android:host="cockpit"/>
            </intent-filter>
            <!-- coroute://subscription: re-reads the plan from the server (no other action) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="coroute" android:host="subscription"/>
            </intent-filter>
            <!-- Invite links: https://coroute.duckdns.org/join/CODE (verified via /.well-known/assetlinks.json) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="coroute.duckdns.org" android:pathPrefix="/join/"/>
            </intent-filter>
            <!-- Same invite links on the new domain (docs/DOMAIN_MIGRATION_devmonks.md): both hosts serve the
                 same assetlinks.json. Release this only once https://coroute.devmonks.space/.well-known/assetlinks.json
                 is live: Android 11 and older verify all autoVerify hosts together. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="coroute.devmonks.space" android:pathPrefix="/join/"/>
            </intent-filter>
        </activity>
        <!-- 3.56 "Share to CoRoute": text shared from a maps app (a place, a maps link, coordinates)
             opens the trip planner with it in the destination search. Invisible trampoline: it
             passes the text to the app's own task and finishes at once (ShareInActivity.kt). -->
        <activity
            android:name=".ShareInActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/share_in_label"
            android:taskAffinity="space.devmonks.coroute_app.share"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- 3.15: invisible trampoline for the SOS button of the ride notification. showWhenLocked lets
             the system start it over the lock screen without the PIN; it opens the app's
             hold-to-send SOS screen (never sends by itself) and finishes at once. Not exported. -->
        <activity
            android:name=".RideSosActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="space.devmonks.coroute_app.sos"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Agent 4: another rider's SOS over the lock screen (full-screen intent of the urgent alert;
             heads-up only when Android 14+ denies full-screen alerts). Shows names only; "Open
             CoRoute" asks for the unlock first. Not exported. -->
        <activity
            android:name=".UrgentAlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTop"
            android:taskAffinity="space.devmonks.coroute_app.urgent"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <!-- Android Quick Settings Tile for Emergency Medical ID -->
        <service
            android:name=".MedicalTileService"
            android:icon="@drawable/ic_medical_cross"
            android:label="Medical ID"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Lock-Screen First Responder ICE Card Activity -->
        <activity
            android:name=".MedicalIdActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="space.devmonks.coroute_app.medical"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <!-- Foreground service that keeps GPS, intercom and the convoy connection alive with the screen locked. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location|microphone"
            android:exported="false"/>
        <!-- flutter_local_notifications: lets the crash alarm buttons (I'm OK / Send now) work on the
             lock screen without unlocking. Not exported: only the system notification can call it. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false"/>
        <!-- flutter_local_notifications: delivers the scheduled plan expiry reminders (7/3/1 days, expiry). -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- 3.57 emergency texts: sent / delivered reports (this app's own PendingIntents), the
             queue's retry alarm, and boot / app update so waiting texts resume. -->
        <receiver
            android:name=".EmergencyTextReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <!-- 3.55 push notifications: FCM data messages (friend requests, crew invites, polls, ride
             invites). Not exported: only Google Play services delivers to it. -->
        <service
            android:name=".CoRouteMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
        <!-- Ride foreground service notification icon (BackgroundService.rideNotificationIcon). -->
        <meta-data
            android:name="space.devmonks.coroute_app.NOTIFICATION_ICON"
            android:resource="@drawable/ic_stat_coroute" />
        <!-- Push notifications shown by Firebase itself (app in background) use the helmet small icon. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_coroute" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher on Android 11+: call, text, open a map, navigate. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="sms"/>
        </intent>
        <!-- Emergency texts open the messages app when SEND_SMS is denied; the phone check looks for it. -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="smsto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="google.navigation"/>
        </intent>
        <!-- Organic Maps offline turn-by-turn navigation scheme -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="om"/>
        </intent>
        <package android:name="app.organicmaps"/>
        <!-- 3.55 "Navigate in Google Maps / Mappls" (NavHandoffChannel.kt): Android 11+ package
             visibility for the installed check and package-targeted turn-by-turn links. -->
        <package android:name="com.google.android.apps.maps"/>
        <package android:name="com.mmi.maps"/>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https" android:host="www.mappls.com"/>
        </intent>
        <!-- Spoken ride alerts (3.15): Android 11+ hides text-to-speech engines without this. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- image_picker: group photo from the camera app (no CAMERA permission is declared, so the
             camera app takes the picture; Android 11+ hides camera apps without this). -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>
</manifest>
