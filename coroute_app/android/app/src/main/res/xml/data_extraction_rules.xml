<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of CoRoute is copied to a cloud backup or to a new phone. The session
     token (flutter_secure_storage, keyed to this device's keystore), the SOS queue and the ride
     data stay on this phone; the rider signs in again on a new one. allowBackup="false" covers
     Android 11 and lower. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
